# Variables de entorno del frontend. Copiar a `.env.local` y ajustar.
# Las `NEXT_PUBLIC_*` se inlinean en el build: NO poner secretos aquí.

# Backend FastAPI. En local: http://localhost:8000
NEXT_PUBLIC_API_URL=https://consulta-placas-ec.onrender.com

# Fuentes en stand-by (M2.5): claves separadas por coma que NO se muestran en la web
# (ni tarjetas, ni enlaces oficiales, ni chips del tablero de fuentes).
# El backend no se toca: sus servicios siguen vivos y dormidos (AGENTS.md §8).
#   "sri,fge"  → default: solo se muestran ANT y AMT/EPMTSD (las que no piden captcha)
#   ""         → reactiva TODAS las fuentes
#   "fge"      → reactiva solo el SRI
# Reactivar = cambiar el valor y volver a desplegar el frontend (sin tocar el backend).
NEXT_PUBLIC_FUENTES_INACTIVAS=sri,fge
